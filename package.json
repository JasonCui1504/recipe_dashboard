{
  "name": "the-cookbook",
  "version": "1.0.0",
  "private": true,
  "description": "An offline, local-first personal cookbook with recipes, pantry, meal planner and shopping list.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --import tsx --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --import tsx --disable-warning=ExperimentalWarning src/server/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
